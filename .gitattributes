# Auto normalize line endings for cross-platform development
* text=auto eol=lf

# Windows scripts and config files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.rc text eol=crlf
*.manifest text eol=crlf

# Images and binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.dll binary
*.exe binary
